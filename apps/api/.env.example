PORT=3001
WEB_ORIGIN=http://localhost:5173
# Leave unset to run health-only mode. Copy your project settings when ready.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-legacy-anon-key
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:54322/postgres
# For hosted PostgreSQL use a TLS-verified connection string (sslmode=verify-full).

# SUPABASE_URL must be the project origin, without /rest/v1 or /auth/v1.
# With a private CA, add sslrootcert pointing to its absolute path in DATABASE_URL.
# Optional local runtime verification (never VITE_ variables):
# TEST_STAFF_EMAIL=your-confirmed-development-test-user
# TEST_STAFF_PASSWORD=your-development-test-password

# MOCK in production requires the explicit hosted-demo flag below.
NODE_ENV=development
PAYMENT_PROVIDER=MOCK
PAYMENT_HOSTED_DEMO_ENABLED=false

# Development-only simulation, never sends real messages.
MOCK_WHATSAPP_ENABLED=true

# Manual production: NODE_ENV=production, PAYMENT_PROVIDER=DISABLED, MOCK_WHATSAPP_ENABLED=false.
# Set WEB_ORIGIN to the exact HTTPS frontend origin (no path or trailing slash).
# Production startup requires Supabase values and DATABASE_URL with sslmode=verify-full.

# Explicit provider selection. META requires every META_* field below. Never put these in VITE_.
WHATSAPP_PROVIDER=DISABLED
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Set a currently supported Graph version from the Meta dashboard, e.g. v25.0.
META_WHATSAPP_API_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_NEAR_TURN_TEMPLATE=
META_WHATSAPP_YOUR_TURN_TEMPLATE=
META_WHATSAPP_TEMPLATE_LANGUAGE=

# Optional development/demo Sandbox: select WHATSAPP_PROVIDER=TWILIO explicitly.
# Every recipient must join the Sandbox AND send an inbound WhatsApp message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Exact HTTPS origin, without a trailing slash. Used to validate signed webhooks.
TWILIO_WEBHOOK_ORIGIN=

# Separate production exception for Twilio Sandbox; independent of payment demo mode.
TWILIO_HOSTED_DEMO_ENABLED=false
# Optional custom database CA as PEM text (real newlines or literal \n), never a file path.
# Production DATABASE_URL must contain sslmode=verify-full and no other SSL parameters.
DATABASE_CA_CERT=
